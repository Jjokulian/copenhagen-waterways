#!/bin/sh
# Generated files should not be edited directly: the next run of their generator
# deletes the edit. This checks the weak version of that rule - if a generated file
# is in the commit, its generator should be too. Override with --no-verify.
python3 scripts/check_generated.py --staged || exit 1
# a cycle in the claim graph is circular reasoning; refuse the commit
python3 scripts/claims.py --check || exit 1
# an output whose input changed is a published number that no longer follows
# from its data; a hand-edit in a generated file is the opposite problem
python3 scripts/freshness.py || exit 1
# every number in a document being committed must have a chain of
# justification - through live_json(), fig(), or written as `code` if it is an
# identifier. No allowance: one bare number refuses the commit.
python3 scripts/figures.py --staged || exit 1
# Links are checked whole rather than per-commit: a link breaks because of what the
# other file did, so staging is the wrong unit for it.
exec python3 scripts/check_links.py
