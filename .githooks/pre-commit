#!/bin/sh
# Generated files should not be edited directly: the next run of their generator
# deletes the edit. This checks the weak version of that rule - if a generated file
# is in the commit, its generator should be too. Override with --no-verify.
python3 scripts/check_generated.py --staged || exit 1
# Links are checked whole rather than per-commit: a link breaks because of what the
# other file did, so staging is the wrong unit for it.
exec python3 scripts/check_links.py
