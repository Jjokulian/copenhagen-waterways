# Raw downloads (~145 MB) are reproducible from the fetch scripts.
data/raw/

# Most of data/derived is reproducible too, but the web bundle and the flood-sheet
# assets ARE the deployed site - committing them means a clone serves it immediately,
# and CI never has to re-crawl a municipal server to rebuild a static page.
data/derived/*
!data/derived/viewer/
!data/derived/registry.json
!data/derived/constructions.geojson
!data/derived/floodgap.json
!data/derived/floodmaps/
# claims are confirmed against the wording each page says them in: without this
# record every confirmation looks stale in a fresh clone
!data/derived/claim_spans.json
# ... but not the heavy intermediates inside it (93 MB of renders, 47 MB of arrays).
data/derived/floodmaps/*.render.png
data/derived/floodmaps/*.band.npy
# data/manual/ is hand-authored and IS tracked.
__pycache__/
*.pyc
data/raw/osm/
data/raw/weather/
data/raw/oda/*.csv
# python venv for the marine/NetCDF stack; recreate with scripts/setup_venv.sh
.venv*/

# hand-in slots: never commit somebody else's licensed data
data/dropin/*
!data/dropin/README.md
data/derived/.construction_hashes.json
data/derived/.*.lock
